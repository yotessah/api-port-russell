
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier une réservation - Port de Russell</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px 15px;
            font-family: Arial, sans-serif;
            background: #eef3f7;
            color: #243447;
        }

        .container {
            max-width: 650px;
            margin: 0 auto;
            padding: 30px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
        }

        h1 {
            color: #174a6e;
        }

        label {
            display: block;
            margin: 20px 0 8px;
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 16px;
        }

        input[readonly] {
            background: #f1f5f9;
        }

        button, .back {
            display: inline-block;
            margin: 20px 8px 0 0;
            padding: 12px 16px;
            border: none;
            border-radius: 6px;
            background: #174a6e;
            color: white;
            font-size: 16px;
            text-decoration: none;
            cursor: pointer;
        }

        button:hover, .back:hover {
            background: #23658f;
        }
    </style>
</head>

<body>
    <main class="container">
        <h1>Modifier une réservation</h1>

        <p>Modifiez les informations de la réservation sélectionnée.</p>

        <form
            action="/catways/<%= reservation.catwayNumber %>/reservations/<%= reservation._id %>"
            method="POST"
        >
            <input type="hidden" name="_method" value="PUT">

            <label for="catwayNumber">Numéro du catway</label>
            <input
                type="number"
                id="catwayNumber"
                value="<%= reservation.catwayNumber %>"
                readonly
            >

            <label for="clientName">Nom du client</label>
            <input
                type="text"
                id="clientName"
                name="clientName"
                value="<%= reservation.clientName %>"
                minlength="2"
                required
            >

            <label for="boatName">Nom du bateau</label>
            <input
                type="text"
                id="boatName"
                name="boatName"
                value="<%= reservation.boatName %>"
                minlength="2"
                required
            >

            <label for="startDate">Date et heure de début</label>
            <input
                type="datetime-local"
                id="startDate"
                name="startDate"
                value="<%= new Date(reservation.startDate).toISOString().slice(0, 16) %>"
                required
            >

            <label for="endDate">Date et heure de fin</label>
            <input
                type="datetime-local"
                id="endDate"
                name="endDate"
                value="<%= new Date(reservation.endDate).toISOString().slice(0, 16) %>"
                required
            >

            <button type="submit">Enregistrer les modifications</button>
        </form>

        <a class="back" href="/dashboard">Tableau de bord</a>
        <a class="back" href="/reservations">Retour aux réservations</a>
    </main>
</body>
</html>
