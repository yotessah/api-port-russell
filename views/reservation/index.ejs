
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réservations - Port de Russell</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #eef3f7;
            color: #243447;
        }

        header {
            padding: 20px 5%;
            background: #174a6e;
        }

        header a {
            color: white;
            text-decoration: none;
        }

        main {
            width: 90%;
            max-width: 1200px;
            margin: 30px auto;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 20px;
        }

        h1 {
            color: #174a6e;
        }

        .button {
            display: inline-block;
            padding: 10px 14px;
            border: none;
            border-radius: 6px;
            background: #174a6e;
            color: white;
            text-decoration: none;
            cursor: pointer;
        }

        .button:hover {
            background: #23658f;
        }

        .table-container {
            overflow-x: auto;
            background: white;
            border-radius: 8px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 14px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }

        th {
            background: #dceaf3;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .empty {
            padding: 25px;
            text-align: center;
            color: #64748b;
        }
    </style>
</head>

<body>
    <header>
        <a href="/dashboard">← Retour au tableau de bord</a>
    </header>

    <main>
        <div class="top">
            <div>
                <h1>Gestion des réservations</h1>
                <p>Consultez les réservations du port de Russell.</p>
            </div>

            <a class="button" href="/reservations/create">
                Ajouter une réservation
            </a>
        </div>

        <section class="table-container">
            <% if (reservations && reservations.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>Catway</th>
                            <th>Client</th>
                            <th>Bateau</th>
                            <th>Date de début</th>
                            <th>Date de fin</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% reservations.forEach(function(reservation) { %>
                            <tr>
                                <td><%= reservation.catwayNumber %></td>
                                <td><%= reservation.clientName %></td>
                                <td><%= reservation.boatName %></td>

                                <td>
                                    <%= new Date(reservation.startDate).toLocaleDateString("fr-FR") %>
                                </td>

                                <td>
                                    <%= new Date(reservation.endDate).toLocaleDateString("fr-FR") %>
                                </td>

                                <td>
                                    <div class="actions">
                                        <a
                                            class="button"
                                            href="/reservations/<%= reservation.catwayNumber %>/<%= reservation._id %>"
                                        >
                                            Détails
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p class="empty">Aucune réservation à afficher pour le moment.</p>
            <% } %>
        </section>
    </main>
</body>
</html>
