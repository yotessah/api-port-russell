
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau de bord - Port de Russell</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #eef3f7;
            color: #243447;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            padding: 20px 5%;
            background: #174a6e;
            color: white;
        }

        header h1 {
            margin: 0;
            font-size: 24px;
        }

        nav {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        header a {
            color: white;
            text-decoration: none;
        }

        .logout,
        .documentation-link {
            padding: 10px 15px;
            border: 1px solid white;
            border-radius: 6px;
        }

        main {
            width: 90%;
            max-width: 1100px;
            margin: 35px auto;
        }

        .welcome {
            margin-bottom: 25px;
        }

        .welcome h2 {
            color: #174a6e;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 35px;
        }

        .card,
        .reservations-section {
            padding: 25px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
        }

        .card h3,
        .reservations-section h2 {
            margin-top: 0;
            color: #174a6e;
        }

        .card p {
            color: #64748b;
            line-height: 1.5;
        }

        .card a {
            display: inline-block;
            margin-top: 10px;
            padding: 10px 14px;
            border-radius: 6px;
            background: #174a6e;
            color: white;
            text-decoration: none;
        }

        .card a:hover {
            background: #23658f;
        }

        .table-container {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th,
        td {
            padding: 13px 12px;
            border-bottom: 1px solid #e2e8f0;
            text-align: left;
        }

        th {
            background: #174a6e;
            color: white;
        }

        tbody tr:hover {
            background: #f8fafc;
        }

        .empty-message {
            padding: 18px 0 0;
            color: #64748b;
        }

        footer {
            padding: 20px;
            text-align: center;
            color: #64748b;
        }

        @media (max-width: 600px) {
            header {
                align-items: flex-start;
            }

            nav {
                width: 100%;
            }

            main {
                width: 94%;
                margin: 25px auto;
            }

            .card,
            .reservations-section {
                padding: 18px;
            }
        }
    </style>
</head>

<body>
    <header>
        <h1>Port de Russell</h1>

        <nav>
            <a class="documentation-link" href="/documentation">
                Documentation API
            </a>

            <a class="logout" href="/logout">
                Se déconnecter
            </a>
        </nav>
    </header>

    <main>
        <section class="welcome">
            <h2>
                Bonjour <%= user.username %> !
            </h2>

            <p>
                Bienvenue sur votre espace de gestion du port.
            </p>

            <p>
                <strong>Adresse e-mail :</strong>
                <%= user.email %>
            </p>

            <p>
                <strong>Date du jour :</strong>
                <%= today.toLocaleDateString("fr-FR") %>
            </p>
        </section>

        <section class="cards">
            <article class="card">
                <h3>Gestion des catways</h3>
                <p>
                    Consultez les catways du port et gérez leur état.
                </p>
                <a href="/catways-page">Voir les catways</a>
            </article>

            <article class="card">
                <h3>Gestion des réservations</h3>
                <p>
                    Consultez et gérez les réservations du port.
                </p>
                <a href="/reservations-page">Voir les réservations</a>
            </article>

            <article class="card">
                <h3>Gestion des utilisateurs</h3>
                <p>
                    Consultez et gérez les comptes utilisateurs.
                </p>
                <a href="/users-page">Voir les utilisateurs</a>
            </article>
        </section>

        <section class="reservations-section">
            <h2>Réservations en cours</h2>

            <% if (reservations && reservations.length > 0) { %>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Catway</th>
                                <th>Client</th>
                                <th>Bateau</th>
                                <th>Date de début</th>
                                <th>Date de fin</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% reservations.forEach(reservation => { %>
                                <tr>
                                    <td><%= reservation.catwayNumber %></td>
                                    <td><%= reservation.clientName %></td>
                                    <td><%= reservation.boatName %></td>
                                    <td>
                                        <%= new Date(reservation.startDate).toLocaleDateString("fr-FR") %>
                                    </td>
                                    <td>
                                        <%= new Date(reservation.endDate).toLocaleDateString("fr-FR") %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p class="empty-message">
                    Aucune réservation en cours aujourd'hui.
                </p>
            <% } %>
        </section>
    </main>

    <footer>
        Application de gestion du port de Russell
    </footer>
</body>
</html>

