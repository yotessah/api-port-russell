<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Port de Russell - Connexion</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
            background: #eef3f7;
            color: #243447;
        }

        .container {
            width: 90%;
            max-width: 420px;
            padding: 35px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        h1 {
            margin-top: 0;
            text-align: center;
            color: #174a6e;
        }

        .subtitle {
            margin-bottom: 25px;
            text-align: center;
            color: #64748b;
        }

        label {
            display: block;
            margin: 15px 0 7px;
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 16px;
        }

        input:focus {
            outline: 2px solid #4b91bd;
            border-color: transparent;
        }

        button {
            width: 100%;
            margin-top: 22px;
            padding: 12px;
            border: none;
            border-radius: 6px;
            background: #174a6e;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        button:hover {
            background: #23658f;
        }

        .error {
            padding: 10px;
            border-radius: 6px;
            background: #fee2e2;
            color: #991b1b;
            text-align: center;
        }

        .footer {
            margin-top: 22px;
            text-align: center;
            font-size: 14px;
        }

        .footer a {
            color: #174a6e;
        }
    </style>
</head>

<body>
    <main class="container">
        <h1>Port de Russell</h1>

        <p class="subtitle">
            Gestion des catways et des réservations
        </p>

        <% if (error) { %>
            <p class="error"><%= error %></p>
        <% } %>

        <form action="/login" method="POST">
            <label for="email">Adresse e-mail</label>
            <input
                type="email"
                id="email"
                name="email"
                autocomplete="username"
                required
            >

            <label for="password">Mot de passe</label>
            <input
                type="password"
                id="password"
                name="password"
                autocomplete="current-password"
                required
            >

            <button type="submit">Se connecter</button>
        </form>

        <div class="footer">
            <p>Application de gestion du port de Russell</p>
        </div>
    </main>
</body>
</html>
